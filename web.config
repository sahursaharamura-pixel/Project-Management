<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Đăng ký iisnode làm handler cho server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_FOR" />
      </allowedServerVariables>
      <rules>

        <!-- Cho phép request debug đi thẳng tới iisnode (không rewrite) -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- File tĩnh: nếu tồn tại trên đĩa thì phục vụ trực tiếp -->
        <rule name="StaticContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <!-- Còn lại: đẩy hết vào Node, kèm IP thật của client (IIS mới biết được, Node qua iisnode thì không) -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="server.js" />
        </rule>

      </rules>
    </rewrite>

    <iisnode
      nodeProcessCommandLine="node.exe"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false" />

    <!-- Chặn truy cập trực tiếp vào các thư mục nhạy cảm -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors errorMode="Detailed" />

  </system.webServer>
</configuration>
